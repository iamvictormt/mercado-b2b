generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  OFFICE
  PRINT
  AGRO
  BUSINESS
  OTHER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuoteStatus {
  REQUESTED
  UNDER_REVIEW
  QUOTED
  IMPORTING
  DELIVERED
  CANCELLED
}

enum SourcingStatus {
  REQUESTED
  SEARCHING
  SUPPLIER_FOUND
  QUOTED
  CLOSED
  CANCELLED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique @db.VarChar(255)
  passwordHash     String?           @map("password_hash") @db.VarChar(255)
  name             String            @db.VarChar(160)
  role             UserRole          @default(CUSTOMER)
  companyId        String?           @map("company_id") @db.Uuid
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requestedQuotes  Quote[]           @relation("QuoteRequester")
  sourcingRequests SourcingRequest[] @relation("SourcingRequester")
  favorites        Favorite[]
  sessions         AuthSession[]
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Company {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(200)
  taxId            String?           @unique @map("tax_id") @db.VarChar(80)
  email            String?           @db.VarChar(255)
  phone            String?           @db.VarChar(40)
  address          String?           @db.Text
  countryCode      String            @default("ST") @map("country_code") @db.Char(2)
  status           CompanyStatus     @default(ACTIVE)
  users            User[]
  quotes           Quote[]
  sourcingRequests SourcingRequest[]
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("companies")
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique @db.VarChar(180)
  namePt        String          @map("name_pt") @db.VarChar(200)
  nameEn        String          @map("name_en") @db.VarChar(200)
  descriptionPt String          @map("description_pt") @db.Text
  descriptionEn String          @map("description_en") @db.Text
  detailPt      String?         @map("detail_pt") @db.VarChar(255)
  detailEn      String?         @map("detail_en") @db.VarChar(255)
  category      ProductCategory
  status        ProductStatus   @default(DRAFT)
  price         Decimal         @db.Decimal(12, 2)
  currency      String          @default("EUR") @db.Char(3)
  originPt      String          @map("origin_pt") @db.VarChar(120)
  originEn      String          @map("origin_en") @db.VarChar(120)
  leadTimePt    String          @map("lead_time_pt") @db.VarChar(120)
  leadTimeEn    String          @map("lead_time_en") @db.VarChar(120)
  minQuantity   Int             @default(1) @map("min_quantity")
  unitPt        String          @map("unit_pt") @db.VarChar(60)
  unitEn        String          @map("unit_en") @db.VarChar(60)
  imageUrl      String?         @map("image_url") @db.Text
  imagePublicId String?         @map("image_public_id") @db.VarChar(255)
  featuredOrder Int             @default(0) @map("featured_order")
  quoteItems    QuoteItem[]
  favorites     Favorite[]
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, category])
  @@index([featuredOrder])
  @@map("products")
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  number        String      @unique @db.VarChar(32)
  companyId     String      @map("company_id") @db.Uuid
  requestedById String?     @map("requested_by_id") @db.Uuid
  status        QuoteStatus @default(REQUESTED)
  currency      String      @default("EUR") @db.Char(3)
  totalAmount   Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes         String?     @db.Text
  validUntil    DateTime?   @map("valid_until") @db.Date
  quotedAt      DateTime?   @map("quoted_at") @db.Timestamptz(3)
  deliveredAt   DateTime?   @map("delivered_at") @db.Timestamptz(3)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy   User?       @relation("QuoteRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([requestedById])
  @@index([status, createdAt])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model SourcingRequest {
  id            String         @id @default(uuid()) @db.Uuid
  number        String         @unique @db.VarChar(32)
  companyId     String         @map("company_id") @db.Uuid
  requestedById String?        @map("requested_by_id") @db.Uuid
  description   String         @db.Text
  quantity      Int?
  budget        Decimal?       @db.Decimal(12, 2)
  currency      String         @default("EUR") @db.Char(3)
  desiredBy     DateTime?      @map("desired_by") @db.Date
  imageUrl      String?        @map("image_url") @db.Text
  imagePublicId String?        @map("image_public_id") @db.VarChar(255)
  status        SourcingStatus @default(REQUESTED)
  internalNotes String?        @map("internal_notes") @db.Text
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy   User?          @relation("SourcingRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId])
  @@index([requestedById])
  @@index([status, createdAt])
  @@map("sourcing_requests")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}
